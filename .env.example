# Port and public URL (used for Stripe redirect URLs)
PORT=3000
PUBLIC_URL=http://localhost:3000

# Anthropic API key - enables real AI designs. Without it the site uses demo templates.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Stripe - enables real $0.99 payments. Without it, payments run in demo mode.
STRIPE_SECRET_KEY=
# Optional: webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Fair-use limit on AI generations per IP per hour
GENERATIONS_PER_HOUR=20
